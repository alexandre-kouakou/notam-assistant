cat > .gitignore << 'EOF'
# Data
data/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
notam/
.pytest_cache/

# Model artifacts and intermediate outputs
*.npy
*.joblib

# Environment
.env

# OS
.DS_Store

# Outputs — ignore by default, then un-ignore versioned deliverables
outputs/*
!outputs/experiments.csv
!outputs/final_evaluation.txt
!outputs/results_trajectory.png
!outputs/results_per_class_delta.png
EOF